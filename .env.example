# Placeholder template; never put credentials here or inject legacy vars publicly.
AEGIS_ENV=production
AEGIS_DEMO_PUBLIC=1
AEGIS_WORKERS=1
# Optional global immutable audit-event limit; default 10000, valid 1..100000.
# At capacity mutations refuse; readiness 503. No automatic history deletion.
AEGIS_DEMO_MAX_EVENTS=10000
AEGIS_PRODUCTION_HOST=0.0.0.0
PORT=8080
# Production fallback, only when PORT is absent.
# Both debug flags must stay disabled; arbitrary AEGIS_*PASSWORD fixture values refused.
AEGIS_DEBUG=0
DEBUG=0
AEGIS_PRODUCTION_PORT=8443
AEGIS_PRODUCTION_DATA_DIR=/data/aegis
AEGIS_TRUSTED_HOSTS=replace-with-public-hostname
AEGIS_TRUSTED_PROXY_CIDRS=
# fly uses edge-replaced Fly-Client-IP only behind an exact trusted peer.
AEGIS_PROXY_PROVIDER=
AEGIS_TLS_KEY_FILE=
AEGIS_TLS_CERT_FILE=
TMPDIR=/data/tmp
HOME=/data
# Private legacy runtime only; public production.py does not import config.py.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8080
AEGIS_HTTPS=1
AEGIS_DATA_DIR=/replace/private/data
AEGIS_SIGNER_STATE=/replace/private/signer
AEGIS_SIGNER_PORT=0
AEGIS_ANCHOR_EXTERNAL=/replace/private/anchor.json
AEGIS_EVIDENCE_KEY=
AEGIS_EVIDENCE_KEY_FILE=
AEGIS_EVIDENCE_KEYRING_FILE=
AEGIS_QWEN_API_KEY=
AEGIS_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AEGIS_MODEL_JUDGE=qwen-max
AEGIS_MODEL_WORKER=qwen-plus
AEGIS_MODEL_FAST=qwen-turbo
AEGIS_SPEND_CAP_USD=5.00
AEGIS_JUDGE_TIMEOUT_S=20
AEGIS_ADAPTIVE_SEED=20261118
AEGIS_ADAPTIVE_SPEND_CAP_USD=1.00
AEGIS_REPLAY_FILE=
AEGIS_RECORD=
AEGIS_AGENT_TOKEN=
# Explicit local optional AI; default launch remains offline.
AEGIS_MODEL_PROVIDER=scripted
AEGIS_MODEL_API_KEY=
AEGIS_MODEL_BASE_URL=https://trusted-provider.example/v1
AEGIS_MODEL_NAME=
AEGIS_LOCAL_AI=0
AEGIS_LOCAL_SESSION_CALLS=15
AEGIS_LOCAL_DAY_CALLS=60
AEGIS_LOCAL_DAY_TOKENS=120000
DEEPSEEK_API_KEY=
# Fixed allowlisted DeepSeek base https://api.deepseek.com; requested legacy alias.
AEGIS_LIVE_MODEL=
AEGIS_LIVE_ACCESS_CODES=
AEGIS_LIVE_SESSION_CALLS=30
AEGIS_LIVE_IP_DAILY_CALLS=60
AEGIS_LIVE_DAILY_CALLS=1500
AEGIS_LIVE_DAILY_TOKENS=2000000
AEGIS_LIVE_MONTHLY_TOKENS=10000000
