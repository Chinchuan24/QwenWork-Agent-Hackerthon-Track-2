# Reference only; never source/load. Set values through platform configuration.
AEGIS_ENV=production
AEGIS_DEMO_PUBLIC=1
AEGIS_WORKERS=1
AEGIS_PRODUCTION_HOST=0.0.0.0
AEGIS_PRODUCTION_DATA_DIR=/data/aegis
PORT=8080
AEGIS_TRUSTED_HOSTS=REPLACE_WITH_EXACT_HOST.example
AEGIS_TRUSTED_PROXY_CIDRS=REPLACE_WITH_VERIFIED_IMMEDIATE_PROXY_CIDRS
AEGIS_PROXY_PROVIDER=fly
AEGIS_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_VIA_PLATFORM_SECRET_STORE
AEGIS_LIVE_ACCESS_CODES=REPLACE_WITH_SHA256_DIGEST_ONLY
AEGIS_LIVE_SESSION_CALLS=30
AEGIS_LIVE_IP_DAILY_CALLS=60
AEGIS_LIVE_DAILY_CALLS=1500
AEGIS_LIVE_DAILY_TOKENS=2000000
AEGIS_LIVE_MONTHLY_TOKENS=10000000
